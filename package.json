{
  "name": "dsh-auto-retry",
  "version": "0.2.0",
  "description": "dsh 自动重试插件：请求级补充重试 / 回合级自动继续 / 无响应看门狗 / 实时通知 / 统计看板",
  "type": "module",
  "main": "lib/index.js",
  "author": "zxmqq1234",
  "homepage": "https://github.com/zxmqq1234/dsh-auto-retry",
  "repository": {
    "type": "git",
    "url": "git@github.com:zxmqq1234/dsh-auto-retry.git"
  },
  "bugs": "https://github.com/zxmqq1234/dsh-auto-retry/issues",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "retry",
    "auto-retry"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "external": [],
      "immediately": false
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.1.7-alpha.1 || ^0.2.0-rc.1"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test scripts/plugin.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
